{
  "functions": {
    "source": "packages/functions"
  },
  "firestore": {
    "rules": "deploy/firestore.rules",
    "indexes": "deploy/firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "reploid",
      "public": ".firebase-hosting/reploid",
      "predeploy": "npm run prepare:hosting",
      "ignore": [
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/zero",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/x",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/passports",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/landing-attribution",
          "run": {
            "serviceId": "reploid-pool",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/retrieval/**",
          "run": {
            "serviceId": "reploid-pool",
            "region": "us-central1"
          }
        },
        {
          "source": "/styles/rd-tokens.css",
          "destination": "/styles/rd.css"
        },
        {
          "source": "/styles/rd-primitives.css",
          "destination": "/styles/rd.css"
        },
        {
          "source": "/styles/rd-components.css",
          "destination": "/styles/rd.css"
        },
        {
          "source": "/rd-tokens.css",
          "destination": "/styles/rd.css"
        },
        {
          "source": "/rd-primitives.css",
          "destination": "/styles/rd.css"
        },
        {
          "source": "/rd-components.css",
          "destination": "/styles/rd.css"
        },
        {
          "source": "/design",
          "destination": "/design.html"
        },
        {
          "source": "/x/design",
          "destination": "/x/design.html"
        },
        {
          "source": "/audit",
          "destination": "/audit.html"
        },
        {
          "source": "/reset",
          "destination": "/reset.html"
        },
        {
          "source": "/pool/policies",
          "run": {
            "serviceId": "reploid-pool",
            "region": "us-central1"
