{
  "schema": "reploid.ordered-participation/v1",
  "stageStorageKey": "reploid.ordered-stage.v1",
  "orchestrationStorageKey": "reploid.ordered-orchestration.v1",
  "limits": {
    "maxStages": 7,
    "maxStageOffersPerPeer": 4,
    "maxRouteBytes": 8192,
    "maxSelectionSteps": 2000,
    "maxRoutes": 4
  },
  "requesterHistory": {
    "database": "reploid-requester-history",
    "maxWorkspaceBytes": 16777216,
    "maxThreads": 64,
    "openTimeoutMs": 10000
  }
}
