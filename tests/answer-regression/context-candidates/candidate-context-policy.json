    "maxResults": 5,
    "maxSourceCharacters": 1200,
    "maxContextCharacters": 6000,
    "timeoutMs": 10000
  },
  "maxima": {
    "maxResults": 10,
    "maxSourceCharacters": 4000,
    "maxContextCharacters": 12000,
    "timeoutMs": 30000
  },
