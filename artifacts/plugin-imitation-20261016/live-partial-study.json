        "cases": [
          {
            "id": "filter",
            "prompt": "Orders: A has 7 paid items; B has 9 unpaid items; C has 6 paid items. How many paid items are there? Reply only with a number.",
            "followup": "Check which orders count, then answer again with only the number.",
            "expected": "13"
          },
          {
            "id": "unknown",
            "prompt": "A report says a parcel arrived on Monday. It does not identify a street. Which street did it arrive on? Reply UNKNOWN if the report does not say.",
            "followup": "Could the report alone establish the street? Reply UNKNOWN if not.",
            "expected": "UNKNOWN"
          },
          {
            "id": "constraints",
            "prompt": "Choose a device with at least 24 GB RAM and a price below 800. A: 16 GB, 500. B: 32 GB, 790. C: 48 GB, 900. Reply with only the letter.",
            "followup": "Check both requirements and return only the letter.",
            "expected": "B"
          },
          {
            "id": "correction",
            "prompt": "The count was 12, then corrected to 9, then finally corrected to 15. Return only the final count.",
            "followup": "Use the last correction, not the first. Return only the number.",
            "expected": "15"
          }
        ],
        "scoring": "Exact trimmed task answer per turn; identification accuracy on imitation rounds; same-model false-positive rate separately. Descriptive pilot only."
