{
  "name": "reploid",
  "version": "0.1.0",
  "description": "Browser-native agent, peer transport and governed improvement services",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clocksmith/reploid.git",
    "directory": "packages/reploid"
  },
  "sideEffects": false,
  "exports": {
    "./chat": {
      "types": "./src/chat/index.d.ts",
      "import": "./src/chat/index.js"
    },
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./mesh": {
      "types": "./src/mesh/index.d.ts",
      "import": "./src/mesh/index.js"
    },
    "./webrtc": {
      "types": "./src/transport/index.d.ts",
      "import": "./src/transport/index.js"
    },
    "./browser": {
      "types": "./src/adapters/browser.d.ts",
      "import": "./src/adapters/browser.js"
    },
    "./doppler": {
      "types": "./src/adapters/doppler.d.ts",
      "import": "./src/adapters/doppler.js"
    },
    "./improve": {
      "types": "./src/improvement/index.d.ts",
      "import": "./src/improvement/index.js"
    },
    "./config": {
      "types": "./src/config/index.d.ts",
      "import": "./src/config/index.js"
    },
    "./config/schema.json": "./src/config/schema.json",
    "./config/profiles/local.json": "./src/config/profiles/local.json",
    "./agent": {
      "types": "./src/agent/index.d.ts",
      "import": "./src/agent/index.js"
    },
    "./diagnostics": {
      "types": "./src/agent/diagnostic-strategy.d.ts",
      "import": "./src/agent/diagnostic-strategy.js"
    },
    "./legacy": {
      "types": "./src/agent/legacy-loop.d.ts",
      "import": "./src/agent/legacy-loop.js"
    },
    "./jobs": {
      "types": "./src/mesh/jobs/index.d.ts",
      "import": "./src/mesh/jobs/index.js"
    },
    "./custody": {
      "types": "./src/artifacts/custody/runtime.d.ts",
      "import": "./src/artifacts/custody/runtime.js"
    }
  },
  "files": [
    "src",
    "!src/**/CATSCAN.md",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "doppler-gpu": ">=0.6.0 <0.7.0"
  },
  "peerDependenciesMeta": {
    "doppler-gpu": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
