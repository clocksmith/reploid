{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Public front for the pilot fleet ledger (server/fleet/ledger-edge-worker.js). Not deployed yet.
  // It is its own Worker: it shares nothing with reploid-fleet-api (different tunnel, VPC service and name).
  "name": "reploid-ledger",
  "account_id": "a83dfba998fd42d3dab5dc607e7c6b60",
  "main": "../../server/fleet/ledger-edge-worker.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // "enabled" only by the owner's decision; while "disabled" every request is a 404 and nothing reaches the binding.
    "LEDGER_ROUTE": "disabled"
  },
  // This Worker's own VPC service (tunnel "reploid-ledger"), separate from reploid-fleet-api's. The tunnel has no public
  // hostname and no private-network route: this binding is its only way in.
  "vpc_services": [{ "binding": "LEDGER", "service_id": "01a21a91-a2f3-7580-b1c1-4d8177a0fcac" }],
  // One Durable Object per rate-limit bucket (caller address, participant, total), counters in memory only.
  "durable_objects": { "bindings": [{ "name": "LEDGER_LIMITS", "class_name": "LedgerRateLimit" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LedgerRateLimit"] }],
  "observability": {
    "enabled": false
  }
}
