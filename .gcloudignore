# Cloud Build receives only the files needed to render deployment environment
# and build the commit-bound Cloud Run runtime image.
**

!.gcloudignore
!.dockerignore
!package.json
!package-lock.json
!packages/
!packages/reploid/
!packages/reploid/package.json
!packages/reploid/src/
!packages/reploid/src/**

!server/
!server/**
server/logs/
server/logs/**

!self/
!self/**

!scripts/
!scripts/print-pool-env.js

!deploy/
!deploy/Dockerfile
!deploy/cloudbuild.yaml
!deploy/env.production.json
!deploy/artifacts/
!deploy/artifacts/doppler-gpu-0.6.27-unicode.1.tgz
