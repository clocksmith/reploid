{
  "format": "box-arrow-diagram/v1",
  "title": "Reploid · Doppler · Doe",
  "subtitle": "Three responsibilities. Two asserted symbiotic relationships.",
  "status": "intended-architecture",
  "basis": "User-provided product and architecture descriptions; not a repository audit or runtime qualification.",
  "defaultView": "ecosystem",
  "coordinates": {
    "origin": "top-left",
    "x": "right",
    "y": "down",
    "unit": "diagram-pixel"
  },
  "theme": {
    "background": "#e9e9e9",
    "surface": "#eeeeee",
    "text": "#202020",
    "muted": "#646464",
    "line": "#373737",
    "border": "#cccccc"
  },
  "edgeTypes": {
    "symbiosis": {
      "label": "Mutual benefit",
      "stroke": "solid",
      "arrow": "none",
      "width": 2.2
    },
    "required": {
      "label": "Required use",
      "stroke": "solid",
      "arrow": "target",
      "width": 1.8
    },
    "optional": {
      "label": "Optional integration",
      "stroke": "dashed",
      "arrow": "target",
      "width": 1.8
    },
    "information": {
      "label": "Information / result",
      "stroke": "dotted",
      "arrow": "target",
      "width": 1.8
    },
    "message": {
      "label": "Request / command",
      "stroke": "solid",
      "arrow": "target",
      "width": 1.8
    },
    "return": {
      "label": "Response / event",
      "stroke": "dotted",
      "arrow": "target",
      "width": 1.8
    }
  },
  "entities": [
    {
      "id": "A",
      "label": "Reploid",
      "responsibility": "Coordinate and improve the intelligence network",
      "owns": [
        "Concurrent conversations and agent coordination",
        "Eligible placement and Bayesian decision-making",
        "Poolday: peer connectivity and authorized WebRTC exchange",
        "Independent evaluation, reversible adoption and strategy evolution"
      ],
      "excludes": [
        "Model mathematics and learned expert selection",
        "WGSL compiler internals",
        "Automatic disclosure or contribution merely from joining"
      ],
      "independence": "An agent may operate independently; the collaborating network remains the product."
    },
    {
      "id": "B",
      "label": "Doppler",
      "responsibility": "Prepare and execute model computation",
      "owns": [
        "Rig: source models, ModelIR, TargetPlans and qualification",
        "Capsules: identified executable programs, weights and dependencies",
        "Run: loading, model operations, adapters and valid partitions",
        "Sampling, tensor contracts and generation-state semantics"
      ],
      "excludes": [
        "Application search policy",
        "Peer membership and placement authority",
        "Provider-specific native driver implementation"
      ],
      "independence": "Usable without Reploid and with supported WebGPU providers other than Doe."
    },
    {
      "id": "C",
      "label": "Doe",
      "responsibility": "Compile WGSL and implement GPU execution",
      "owns": [
        "WGSL compilation and general shader optimization",
        "Native Metal, Vulkan and D3D12 execution paths",
        "GPU resource ownership, synchronization and failure reporting",
        "General diagnostics useful to unrelated applications"
      ],
      "excludes": [
        "Model selection, tokenization or quantization policy",
        "Search ranking and agent objectives",
        "Automatic replacement of a browser’s GPU implementation"
      ],
      "independence": "Useful to applications unrelated to Doppler; integration requires an explicit provider boundary."
    }
  ],
  "nonAssertions": [
    "No direct Reploid–Doe cooperation or dependency is asserted.",
    "Mutual benefit does not imply a required dependency.",
    "This diagram does not claim demonstrated frontier-scale, partitioned inference or recursive improvement.",
    "A WebGPU application cannot switch a browser’s underlying implementation merely by importing Doe."
  ],
