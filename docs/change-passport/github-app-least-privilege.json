    "secrets",
    "workflows:write"
  ],
  "effectAdapters": {
    "deployment": "separately_enabled",
    "permissionRevocation": "separately_enabled",
    "rollback": "separately_enabled"
  },
  "installationScope": ["clocksmith/reploid"],
  "qualificationGranted": false
}
