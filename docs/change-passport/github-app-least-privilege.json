{
  "schema": "reploid.github-app-permission-contract/v1",
  "appSlug": "reploid-change-passport",
  "appId": 4693600,
  "defaultPermissions": {"checks": "write", "metadata": "read", "pullRequests": "read"},
  "defaultEvents": ["pull_request", "pull_request_review"],
